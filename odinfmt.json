{
    "$schema": "https://raw.githubusercontent.com/DanielGavin/ols/refs/heads/master/misc/odinfmt.schema.json",
    "brace_style": "_1TBS",
    "character_width": 110,
    "spaces": 4,
    "newline_limit": 40,
    "newline_style": "LF",
    "sort_imports": true,
    "indent_cases": false,
    "space_single_line_blocks": true,
    "spaces_around_colons": false,
    "align_struct_fields": true,
    "align_struct_values": true,
    "convert_do": true,
    "inline_single_stmt_case": false,
    "exp_multiline_composite_literals": false,
    "tabs": true,
    "tabs_width": 4
}
